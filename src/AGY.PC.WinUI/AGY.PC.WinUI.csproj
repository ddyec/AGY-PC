<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <UseWinUI>true</UseWinUI>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    <EnableDefaultPageItems>false</EnableDefaultPageItems>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <WindowsAppSDKDeploymentManagerInitialize>false</WindowsAppSDKDeploymentManagerInitialize>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <Platforms>x64;ARM64</Platforms>
    <AssemblyName>AGY-PC</AssemblyName>
    <RootNamespace>AGY.PC.WinUI</RootNamespace>
    <Version>2.0.0-beta.2</Version>
    <ApplicationIcon>Assets/AGY.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PublishTrimmed>false</PublishTrimmed>
    <DebugType>embedded</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../AGY.PC.Core/AGY.PC.Core.csproj"/>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.6.4"/>
    <!-- WinUI.props and the .NET SDK both glob Assets. Own this list once,
         while retaining native EXE icon embedding through ApplicationIcon. -->
    <Content Remove="Assets/**"/>
    <None Remove="Assets/**"/>
    <Content Include="Assets/Mark.png" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"/>
    <Content Include="Assets/AGY.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"/>
  </ItemGroup>
  <Target Name="ValidateWinUIAssetUniqueness" BeforeTargets="CoreCompile;BeforeGenerateProjectPriFile">
    <ItemGroup>
      <_AGYAsset Include="@(Content)" Condition="$([System.String]::Copy('%(Content.Identity)').Replace('\', '/').StartsWith('Assets/'))"/>
    </ItemGroup>
    <RemoveDuplicates Inputs="@(_AGYAsset-&gt;'%(FullPath)')">
      <Output TaskParameter="Filtered" ItemName="_AGYUniqueAsset"/>
    </RemoveDuplicates>
    <Error Condition="'@(_AGYAsset-&gt;Count())' != '@(_AGYUniqueAsset-&gt;Count())'"
           Text="AGY Assets contain duplicate Content items. Check SDK default globs before PRI generation."/>
  </Target>
</Project>
